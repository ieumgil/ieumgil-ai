# 브라우저에 노출됨 — 카카오 개발자 콘솔에서 사이트 도메인 제한 필수
NEXT_PUBLIC_KAKAO_JS_KEY=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
KAKAO_REST_API_KEY=
# AI: Gemini를 먼저 쓰고, 붐비거나(503) 30초 넘게 늦으면 OpenAI로 넘긴다(둘 중 하나는 꼭 필요)
GEMINI_API_KEY=
OPENAI_API_KEY=
# 선택: OpenAI 모델(기본 gpt-6-luna) · 순서 바꾸기(기본 gemini,openai) · 넘기기 전 기다리는 시간(기본 30000ms)
OPENAI_MODEL=
AI_ORDER=
AI_HEDGE_MS=
# 선택: Gemini 모델 바꾸기(기본 gemini-3.5-flash-lite / gemini-3.8-flash)
GEMINI_MODEL_FAST=
GEMINI_MODEL_READ=
# 공유 링크(Supabase, 서버 전용): 프로젝트 URL과 service_role 키. 테이블은 supabase/migrations/의 SQL을 한 번 실행
# 비워 두면 공유 버튼은 "아직 준비 중"으로 안내한다
# 선택: Vercel Cron이 하루 한 번 /api/keepalive로 Supabase를 깨워 둘 때 쓰는 비밀값(Vercel에 넣으면 Vercel 요청만 받음)
CRON_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 날씨 = 기상청 단기·중기예보(서버 전용). 공공데이터포털에서 단기(15084084)·중기(15059468) 둘 다 활용신청 후 일반 인증키(Decoding)를 넣는다
# 비워 두면 날씨 칸만 숨긴다
KMA_API_KEY=
# 선택: 게이트웨이(기본 portal = 공공데이터포털이라 비워 두면 된다, apihub = 기상청 API허브용 별도 키가 있을 때만). 어느 쪽이 되는지는 npx tsx scripts/dev/weather-probe.ts로 확인
KMA_GATEWAY=

# 데이터 정리 스크립트 전용
TOUR_API_KEY=
