# 브라우저에 노출됨 — 카카오 개발자 콘솔에서 사이트 도메인 제한 필수
NEXT_PUBLIC_KAKAO_JS_KEY=

# 서버 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
KAKAO_REST_API_KEY=
# AI: Gemini를 먼저 쓰고, 붐비거나(503) 30초 넘게 늦으면 OpenAI로 넘긴다(둘 중 하나는 꼭 필요)
GEMINI_API_KEY=
OPENAI_API_KEY=
# 선택: OpenAI 모델(기본 gpt-6-luna) · 순서 바꾸기(기본 gemini,openai) · 넘기기 전 기다리는 시간(기본 30000ms)
OPENAI_MODEL=
AI_ORDER=
AI_HEDGE_MS=
# 선택: Gemini 모델 바꾸기(기본 gemini-3.5-flash-lite / gemini-3.8-flash)
GEMINI_MODEL_FAST=
GEMINI_MODEL_READ=
# 나중에(공유 기능)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 데이터 정리 스크립트 전용
